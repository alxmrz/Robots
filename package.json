{
  "name": "Robots",
  "dependencies": {
    "babel-plugin-syntax-dynamic-import": "^6.18.0",
    "babel-preset-env": "^1.7.0",
    "http-server": "^14.1.0",
    "phaser": "^4.2.1",
    "phaser4-rex-plugins": "^4.2.0",
    "vue": "^3.5.46"
  },
  "scripts": {
    "build": "npx webpack build --config webpack.config.js",
    "watch": "npx webpack watch --config webpack.config.js ",
    "start": "npx http-server ./dist/",
    "tests": "jest",
    "tests-coverage": "jest --coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.14.0",
    "@babel/preset-env": "^7.16.11",
    "babel-loader": "^8.2.2",
    "css-loader": "^6.6.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^27.4.7",
    "jest-canvas-mock": "^2.3.1",
    "sinon": "^13.0.0",
    "style-loader": "^4.0.0",
    "vue-loader": "^17.4.2",
    "@vue/compiler-sfc": "^3.5.46",
    "webpack": "^5.36.2",
    "webpack-cli": "^4.6.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "jest-canvas-mock"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    },
    "moduleFileExtensions": [
      "js",
      "jsx"
    ],
    "moduleDirectories": [
      "node_modules"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(phaser4-rex-plugins)/)"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/tests/mocks/fileMock.js",
      "\\.(css|less)$": "<rootDir>/tests/mocks/styleMock.js",
      "^phaser$": "<rootDir>/node_modules/phaser/dist/phaser.js",
      "^@app(.*)$": "<rootDir>/src$1"
    }
  }
}
